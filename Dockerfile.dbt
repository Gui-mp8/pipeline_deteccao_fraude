FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DBT_PROFILES_DIR=/usr/app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    git \
  && rm -rf /var/lib/apt/lists/*

RUN pip install "dbt-bigquery>=1.8,<2"

COPY dbt /usr/app
COPY scripts/dbt-entrypoint.sh /usr/local/bin/dbt-entrypoint.sh

RUN chmod +x /usr/local/bin/dbt-entrypoint.sh

WORKDIR /usr/app
ENTRYPOINT ["dbt-entrypoint.sh"]
CMD ["build", "--select", "gold.*"]
